# Salin file ini menjadi .env lalu isi nilainya. JANGAN commit file .env.
# Database PostgreSQL (wajib untuk menjalankan aplikasi)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Kunci penanda tanganan sesi cookie (wajib diset di produksi Vercel)
AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# Akun Super Admin awal untuk prisma db seed (opsional)
SEED_ADMIN_EMAIL="admin@bpsdm.jabarprov.go.id"
SEED_ADMIN_PASSWORD="AdminBpsdm2026!"

# Kunci API Google Gemini untuk fitur "Buat dengan AI" di halaman Ekspose (opsional).
GEMINI_API_KEY=""

# Model Gemini yang dipakai (opsional; biarkan kosong untuk memakai bawaan aplikasi)
GEMINI_MODEL=""
