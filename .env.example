# Salin file ini menjadi .env lalu isi nilainya. JANGAN commit file .env.
# Database PostgreSQL (wajib untuk menjalankan aplikasi)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Kunci API Google Gemini untuk fitur "Buat dengan AI" di halaman Ekspose (opsional).
# Kalau dikosongkan, pembahasan memakai template baku (tetap benar angkanya).
# Cara membuat kunci: buka Google AI Studio (https://aistudio.google.com/apikey),
# buat API key, lalu tempel di sini. JANGAN bagikan kunci ini ke siapa pun.
GEMINI_API_KEY=""

# Model Gemini yang dipakai (opsional; biarkan kosong untuk memakai bawaan aplikasi)
GEMINI_MODEL=""
