datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

model User {
  id                 String         @id @default(cuid())
  nama               String
  email              String?        @unique
  nip                String?        @unique
  passwordHash       String
  passwordEncrypted  String?
  role               String         @default("EVALUATOR") // "SUPER_ADMIN" | "EVALUATOR"
  mustChangePassword Boolean        @default(false)
  aktif              Boolean        @default(true)
  timDiampu          TimEvaluator[]
  kegiatanDibuat     Kegiatan[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model Kegiatan {
  id             String          @id @default(cuid())
  nama           String
  jenisPelatihan String          @default("PKP") // "PKP" | "PKA" | "PKN"
  penyelenggara  String
  lokasi         String
  tanggalMulai   DateTime
  tanggalSelesai DateTime
  createdById    String
  createdBy      User            @relation(fields: [createdById], references: [id])
  peserta        Peserta[]
  tim            TimEvaluator[]
  pembahasan     Pembahasan[]
  aiJobs         AiJob[]
  selisihImport  SelisihImport[]
  inovasiProper  InovasiProper[]
  uploadedFiles  UploadedFile[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model TimEvaluator {
  id          String    @id @default(cuid())
  kegiatanId  String
  kegiatan    Kegiatan  @relation(fields: [kegiatanId], references: [id], onDelete: Cascade)
  urutan      Int
  namaTim     String
  linkMeeting String?
  evaluatorId String?
  evaluator   User?     @relation(fields: [evaluatorId], references: [id], onDelete: SetNull)
  peserta     Peserta[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([kegiatanId, urutan])
  @@index([evaluatorId])
  @@index([kegiatanId, evaluatorId])
  @@index([namaTim(ops: raw("gin_trgm_ops"))], type: Gin)
}

model Peserta {
  id                  String          @id @default(cuid())
  kegiatanId          String
  kegiatan            Kegiatan        @relation(fields: [kegiatanId], references: [id], onDelete: Cascade)
  timId               String?
  tim                 TimEvaluator?   @relation(fields: [timId], references: [id], onDelete: SetNull)
  nama                String
  nip                 String?
  jabatanPelatihan    String?
  instansiPelatihan   String?
  jabatanSaatIni      String?
  instansi            String?
  pelatihan           String          @default("PKP")
  angkatan            String          @default("VII")
  tahun               Int             @default(2023)
  metode              String?
  judulAksiPerubahan  String?
  periodeMenengah     String?
  periodePanjang      String?
  namaTimExcel        String?
  namaAtasan          String?
  jabatanAtasan       String?
  instansiAtasan      String?
  lockedImport        Boolean         @default(true)
  wawancaraSelesaiAt  DateTime?
  survey              Survey[]
  wawancara           Wawancara[]
  hasil               HasilEkspose?
  inovasiProper       InovasiProper?
  selisihImport       SelisihImport[]
  createdAt           DateTime        @default(now())

  @@index([kegiatanId])
  @@index([timId])
  @@index([kegiatanId, nip])
  @@index([kegiatanId, nama])
  @@index([kegiatanId, timId, nama])
  @@index([kegiatanId, wawancaraSelesaiAt])
  @@index([nama(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([nip(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([instansi(ops: raw("gin_trgm_ops"))], type: Gin)
}

model Survey {
  id          String  @id @default(cuid())
  pesertaId   String
  peserta     Peserta @relation(fields: [pesertaId], references: [id], onDelete: Cascade)
  responden   String  // "alumni" | "atasan"
  kode        String  // "L4_01".."L4_03", "L3_01".."L3_30", "HK_33".."HK_34", "DUK_38".."DUK_42", "DUK_TEXT", "KND_43".."KND_45", "KND_TEXT"
  kelompok    String? // "PERILAKU" | "HASIL_KONTRIBUSI" | "HASIL_AKSI" | "DUKUNGAN" | "KENDALA"
  subDimensi  String? // Sub-dimensi BerAKHLAK / OlahData2
  pertanyaan  String?
  jawabanTeks String?
  skor        Int?
  sumber      String  @default("Jawaban")

  @@unique([pesertaId, responden, kode])
  @@index([pesertaId, kelompok])
}

model Wawancara {
  id               String   @id @default(cuid())
  pesertaId        String
  peserta          Peserta  @relation(fields: [pesertaId], references: [id], onDelete: Cascade)
  kriteria         String   // "menengah" | "jangkaPanjang" | "seluruhTujuan" | "manfaat" | "komunikasi"
  bobot            Int      // 20, 20, 20, 30, 10
  nilai            Int?     // 0-100, null = KOSONG
  lockedFromImport Boolean  @default(false)
  deskripsi        String?
  sumber           String   @default("Form") // "Form" | "Evaluator" | "KOSONG"
  updatedById      String?
  updatedAt        DateTime @updatedAt

  @@unique([pesertaId, kriteria])
}

model HasilEkspose {
  id             String   @id @default(cuid())
  pesertaId      String   @unique
  peserta        Peserta  @relation(fields: [pesertaId], references: [id], onDelete: Cascade)
  rataSurveiL    Float?
  rataWawancaraM Float?
  totalForm      Float?
  selisih        Float?
  rangeSurvei    String?
  rangeWawancara String?
  updatedAt      DateTime @updatedAt
}

model SelisihImport {
  id           String   @id @default(cuid())
  kegiatanId   String
  kegiatan     Kegiatan @relation(fields: [kegiatanId], references: [id], onDelete: Cascade)
  pesertaId    String
  peserta      Peserta  @relation(fields: [pesertaId], references: [id], onDelete: Cascade)
  kriteria     String   // "menengah" | "jangkaPanjang" | "seluruhTujuan" | "manfaat"
  nilaiForm    Float?
  nilaiEkspose Float?
  catatan      String?
  createdAt    DateTime @default(now())

  @@index([kegiatanId])
  @@index([kegiatanId, pesertaId])
}

model UploadedFile {
  id         String   @id @default(cuid())
  kegiatanId String
  kegiatan   Kegiatan @relation(fields: [kegiatanId], references: [id], onDelete: Cascade)
  filename   String
  mimeType   String
  sizeBytes  Int
  data       Bytes
  createdAt  DateTime @default(now())

  @@index([kegiatanId])
}

model InovasiProper {
  id                      String   @id @default(cuid())
  kegiatanId              String
  kegiatan                Kegiatan @relation(fields: [kegiatanId], references: [id], onDelete: Cascade)
  pesertaId               String   @unique
  peserta                 Peserta  @relation(fields: [pesertaId], references: [id], onDelete: Cascade)
  judulProper             String
  jangkaMenengahMilestone String
  jangkaMenengahStatus    String   @default("BELUM_DILAKSANAKAN") // "SUDAH_DILAKSANAKAN" | "BELUM_DILAKSANAKAN"
  jangkaMenengahFotoId    String?
  jangkaMenengahFotoNama  String?
  jangkaPanjangMilestone  String
  jangkaPanjangStatus     String   @default("BELUM_DILAKSANAKAN")
  jangkaPanjangFotoId     String?
  jangkaPanjangFotoNama   String?
  kondisiSaatIni          String
  dokumenFileId           String?
  dokumenNama             String?
  dokumenSizeBytes        Int?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([kegiatanId])
}

model Pembahasan {
  id          String   @id @default(cuid())
  kegiatanId  String
  kegiatan    Kegiatan @relation(fields: [kegiatanId], references: [id], onDelete: Cascade)
  grafikKey   String   // "grafik1" .. "grafik5" | "kesimpulan"
  judul       String
  poin1       String
  poin2       String
  poin3       String
  poin4       String
  teksLengkap String
  sumber      String   @default("template") // "template" | "ai" | "manual"
  updatedAt   DateTime @updatedAt

  @@unique([kegiatanId, grafikKey])
}

model AiJob {
  id          String    @id @default(cuid())
  kegiatanId  String
  kegiatan    Kegiatan  @relation(fields: [kegiatanId], references: [id], onDelete: Cascade)
  batchId     String?
  grafikKey   String    // "grafik1" .. "grafik5" | "kesimpulan"
  status      String    @default("queued") // "queued" | "processing" | "done" | "failed"
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  modelUsed   String?
  lastError   String?
  nextRunAt   DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([kegiatanId, status, nextRunAt, createdAt])
  @@index([kegiatanId, grafikKey, status])
}
